# Copie para `.env`. Nunca versione a copia preenchida.

GROQ_API_KEY=
# ID hospedado pela Groq; esta integração usa a chave e a cobrança da Groq.
GROQ_MODEL=openai/gpt-oss-20b

COMIC_VINE_API_KEY=

# Necessárias somente com `--publish`.
# No GitHub Actions, use o JSON completo neste secret.
FIREBASE_SERVICE_ACCOUNT_JSON=
# FIREBASE_SERVICE_ACCOUNT continua aceito como alias legado.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
FIRESTORE_DATABASE_ID=
